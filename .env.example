# Copy to `.env.local` and fill in. Structure matches the active cloud setup.
# Validate: npm run env:check

# Supabase Client
# Dashboard → Project Settings → API Keys (publishable = sb_publishable_*)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_NAME=your-project-name
SUPABASE_DB_PASSWORD=

# Supabase Server
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_CONNECTION_STRING=

# Pin the eve dev sidecar to a fixed port so a mid-session crash fails fast
# instead of hanging /chat forever. `npm run dev` health-checks this origin;
# if the sidecar dies while Next keeps running: `npm run dev:eve:pinned`.
EVE_BASE_URL=http://127.0.0.1:2000

# Cal.com API v2
# Docs: slots = 2024-09-04; bookings = 2024-08-13; event-types = 2024-06-14
# Optional bootstrap only — prefer Dashboard → Settings (AI booking) + Meeting types
# Username for booking URLs is loaded from Cal.com GET /v2/me (also cached on workspace)
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_EVENT_TYPE_SLUG=30min
CALCOM_USERNAME=
CALCOM_API_BASE_URL=https://api.cal.com/v2

BOOKING_NAME=
BOOKING_TIMEZONE=Asia/Ho_Chi_Minh
BOOKING_PHONE=
BOOKING_ADDRESS=

# Slot names: deepseekFlash | deepseekPro | geminiFlash | claudeHaiku
AGENT_DEFAULT_MODEL=deepseekFlash
# Optional: force one slot for all turns
# AGENT_MODEL=geminiFlash

# Model providers (each its own key; NOT AI Gateway)
# DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Google Gemini: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Anthropic Claude: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Guest booking change — OTP email (optional; without key, OTP falls back to staff request)
RESEND_API_KEY=
EVE_MAIL_FROM=Eve <no-reply@example.com>
# Pepper for manage-code / OTP hashes (fallback: WORKSPACE_SECRETS_KEY; rotate in prod)
BOOKING_MANAGE_CODE_PEPPER=

# Encrypt Cal.com API keys stored per workspace (fallback: SUPABASE_SECRET_KEY / SUPABASE_SERVICE_ROLE_KEY)
WORKSPACE_SECRETS_KEY=

# Booking pilot fallback (demo workspace)
BOOKING_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
NEXT_PUBLIC_BOOKING_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
# Must match Cal.com meeting type "Minimum booking notice" (hours) — for chat explanations only
BOOKING_MIN_NOTICE_HOURS=2
# Sync: full mirror of every Cal.com list filter (no date cutoff)
BOOKING_SYNC_PAGE_LIMIT=100
# Safety only — raise if toast shows truncated (calendars very large)
BOOKING_SYNC_MAX_PAGES=100
BOOKING_SYNC_STORE_RAW=false

# Cal.com OAuth (preferred over API key for workspace connections)
# Create an OAuth client at https://app.cal.com/settings/developer/oauth
CALCOM_OAUTH_CLIENT_ID=
CALCOM_OAUTH_CLIENT_SECRET=
CALCOM_OAUTH_REDIRECT_URI=http://localhost:3000/api/cal/oauth/callback

# Cal.com webhook → POST /api/cal/webhook?workspace_id=… (HMAC-SHA256 secret)
# Pilot-only fallback — real tenants must have a per-workspace secret (auto-generated
# in Settings → Cal.com webhook, encrypted at rest in workspaces.webhook_secret_encrypted).
CALCOM_WEBHOOK_SECRET=

# Vercel Cron → GET /api/cron/tick (Authorization: Bearer …)
# Generate a long random string; set the same value in the Vercel project env.
CRON_SECRET=

# Public signup gate: open (default) | invite_only
EVE_SIGNUP_MODE=open

# Show raw agent tool-call cards (load_skill, book_appointment, ...) in guest
# chat — debugging only. Unset/false hides them everywhere, including local dev.
NEXT_PUBLIC_EVE_SHOW_TOOL_CALLS=

# --- Analytics (PostHog)
# Missing key = silent no-op; app still runs.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Billing (Polar international + SePay VietQR)
# none = billing disabled entirely; all features unlocked
# test = all features unlocked; checkout returns fake URLs (local/dev)
# live = Polar + SePay required for real checkout
BILLING_MODE=test
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_STARTER_PRODUCT_ID=
POLAR_PRO_PRODUCT_ID=
# sandbox | production (default production)
POLAR_SERVER=sandbox
SEPAY_WEBHOOK_API_KEY=
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_NAME=
SEPAY_ACCOUNT_NAME=
SEPAY_STARTER_AMOUNT_VND=499000
SEPAY_PRO_AMOUNT_VND=1299000

# --- Error monitoring (Sentry)
# Missing DSN = no-op; app still runs. Source maps upload needs auth token + org/project.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Facebook Messenger
# Create a Meta app at https://developers.facebook.com/apps + add Messenger product.
META_APP_ID=
META_APP_SECRET=
# Override the default redirect URI (default: <origin>/api/messenger/oauth/callback)
# META_REDIRECT_URI=http://localhost:3000/api/messenger/oauth/callback
# Token for webhook verification (GET challenge); set any random string.
MESSENGER_VERIFY_TOKEN=
# Created by Vercel CLI
VERCEL_OIDC_TOKEN=

# Zalo Official Account (developers.zalo.me → your app → Official Account API)
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_SECRET_KEY=
ZALO_REDIRECT_URI=http://localhost:3000/api/zalo/oauth/callback
# Local testing only: log outbound Zalo messages instead of sending them.
# Refuses to load when NODE_ENV=production.
ZALO_DRY_RUN=1

# Public origin of this Next app (OAuth redirectTo via appOrigin() in lib/app-origin.ts)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth login (sign in with Google)
# Enable in Supabase Dashboard → Auth → Providers → Google
# Redirect URI in Google Cloud Console:
#   https://YOUR_PROJECT_REF.supabase.co/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
