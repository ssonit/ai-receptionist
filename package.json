  "scripts": {
    "postinstall": "node ./scripts/patch-eve-package-resolve.mjs",
    "prepare:eve": "npm run patch:eve && eve build && node ./scripts/sync-eve-compile.mjs",
    "ensure:eve": "node ./scripts/ensure-eve-compile.mjs",
    "build": "npm run prepare:eve && next build",
    "dev": "npm run ensure:eve && next dev",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:eve": "eve build && node ./scripts/sync-eve-compile.mjs",
    "dev:eve": "eve dev",
    "start:eve": "eve start",
    "patch:eve": "node ./scripts/patch-eve-package-resolve.mjs",
    "sync:eve": "node ./scripts/sync-eve-compile.mjs",
    "doctor": "npx react-doctor@latest --verbose --scope changed",
    "doctor:full": "npx react-doctor@latest --verbose"
  },
