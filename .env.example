# Supabase (local: `npx supabase start` then copy keys from `supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Pin the eve dev sidecar to a fixed port (recommended for local dev). Without
# this, withEve spawns `eve dev` on a random port and caches that origin in
# memory for the life of the `next dev` process — if the sidecar dies mid-
# session, chat requests hang forever with no error instead of failing fast.
# `npm run dev` auto-starts/health-checks this pinned sidecar; if it ever dies
# while `next dev` keeps running, restart it with `npm run dev:eve:pinned`.
EVE_BASE_URL=http://127.0.0.1:2000

# ── Model providers (each provider = its own key; NOT AI Gateway) ──────────
# DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Google Gemini: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Anthropic Claude: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Slot names: deepseekFlash | deepseekPro | geminiFlash | claudeHaiku
AGENT_DEFAULT_MODEL=deepseekFlash
# Optional: force one slot for all turns
# AGENT_MODEL=geminiFlash

# Cal.com API v2
# Docs: slots = 2024-09-04; bookings = 2024-08-13; event-types = 2024-06-14
CALCOM_API_KEY=
CALCOM_API_BASE_URL=https://api.cal.com/v2
# Optional bootstrap only — prefer Dashboard → Settings (AI booking) + Meeting types
# Username for booking URLs is loaded from Cal.com GET /v2/me (also cached on workspace)
CALCOM_EVENT_TYPE_ID=
CALCOM_EVENT_TYPE_SLUG=consultation-30
CALCOM_USERNAME=

# Guest booking change — OTP email (optional; without key, OTP falls back to staff request)
RESEND_API_KEY=
EVE_MAIL_FROM=Eve <no-reply@yourdomain.com>
# Optional pepper for manage-code hashes (fallback: WORKSPACE_SECRETS_KEY)
BOOKING_MANAGE_CODE_PEPPER=

# Vercel Cron → GET /api/cron/tick (Authorization: Bearer …)
# Generate a long random string; set the same value in the Vercel project env.
CRON_SECRET=

# Encrypt Cal.com API keys stored per workspace (fallback: SUPABASE_SERVICE_ROLE_KEY)
WORKSPACE_SECRETS_KEY=

# Booking pilot fallback (local demo / Eve CLI when no chat session tenant)
BOOKING_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
NEXT_PUBLIC_BOOKING_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
BOOKING_NAME=Eve Pilot
BOOKING_TIMEZONE=Asia/Ho_Chi_Minh
# Must match Cal.com meeting type "Minimum booking notice" (hours) — for chat explanations only
BOOKING_MIN_NOTICE_HOURS=2
# Sync: full mirror of every Cal.com list filter (no date cutoff)
BOOKING_SYNC_PAGE_LIMIT=100
# Safety only — raise if toast shows truncated (calendars rất lớn)
BOOKING_SYNC_MAX_PAGES=100
BOOKING_SYNC_STORE_RAW=false

# Public signup gate: open (default) | invite_only
EVE_SIGNUP_MODE=open

# ── Analytics (PostHog) ─────────────────────────────────────────────────────
# Missing key = silent no-op; app still runs.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Error monitoring (Sentry) ───────────────────────────────────────────────
# Missing DSN = no-op; app still runs. Source maps upload needs auth token + org/project.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
